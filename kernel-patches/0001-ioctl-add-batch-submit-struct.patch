+struct rknpu_batch_submit {
+	__u32 n_jobs;
+	__u32 reserved;
+	__u64 jobs_ptr;
+};
+
+#define IOCTL_RKNPU_BATCH_SUBMIT RKNPU_IOWR(RKNPU_BATCH_SUBMIT, struct rknpu_batch_submit)
+#define DRM_IOCTL_RKNPU_BATCH_SUBMIT \
+	DRM_IOWR(DRM_COMMAND_BASE + RKNPU_BATCH_SUBMIT, struct rknpu_batch_submit)
